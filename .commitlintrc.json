{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "docs", "style", "refactor", "perf", "test", "build", "ci", "chore", "revert"]
    ],
    "scope-enum": [2, "always", ["auth", "ui", "api", "core", "deps", "config", "test", "docs"]],
    "scope-empty": [2, "never"],
    "subject-case": [2, "always", ["lower-case"]]
  }
}
